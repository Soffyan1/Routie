{
  "name": "routie",
  "type": "module",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@11.16.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "npm run dev -w @routie/web",
    "dev:worker": "npm run dev -w @routie/worker",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "npm run db:generate -w @routie/db",
    "db:migrate": "npm run db:migrate -w @routie/db",
    "db:seed": "npm run db:seed -w @routie/db"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "dotenv-cli": "^10.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}

# Core
NODE_ENV=development
APP_URL=http://localhost:3000
DATABASE_URL=postgres://routie:routie@localhost:5433/routie
# Privileged, backend-only roles used by trusted integrations and cross-tenant workers.
DATABASE_INTEGRATION_URL=postgres://routie:routie@localhost:5433/routie
DATABASE_WORKER_URL=postgres://routie:routie@localhost:5433/routie
REDIS_URL=redis://localhost:6379
SESSION_SECRET=replace-with-at-least-32-random-characters
ENVELOPE_MASTER_KEY=replace-with-base64-encoded-32-byte-key

# Server Pulsa integration
SERVER_PULSA_BASE_URL=http://localhost:4000
SERVER_PULSA_SERVICE_TOKEN=replace-me
SERVER_PULSA_WEBHOOK_SECRET=replace-me

# Email / storage
EMAIL_FROM=Routie <noreply@example.com>
SMTP_URL=smtp://localhost:1025
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-southeast-1
S3_BUCKET=routie
S3_ACCESS_KEY=minio
S3_SECRET_KEY=miniosecret

# Queue and platform feature flags
WORKER_CONCURRENCY=3
# Media dari publish yang sukses dibersihkan setelah jumlah hari ini.
MEDIA_RETENTION_DAYS=30
ENABLE_META_AUTO_PUBLISH=false
# Enable only after TikTok's Content Posting API review and a verified media URL prefix.
ENABLE_TIKTOK_DRAFT_SYNC=false
ENABLE_TIKTOK_AUTO_PUBLISH=false
ENABLE_THREADS_AUTO_PUBLISH=false
ENABLE_YOUTUBE_AUTO_PUBLISH=false

# Meta OAuth (Facebook Pages + linked Instagram Professional accounts)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/api/auth/callback/meta
META_GRAPH_API_VERSION=v24.0

# Threads OAuth (the Threads use case can expose a dedicated App ID/secret)
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=http://localhost:3000/api/auth/callback/threads

# TikTok OAuth + Content Posting API. Register this exact redirect URI in the
# TikTok Developer Portal. TIKTOK_MEDIA_URL_PREFIX must be a verified public
# HTTPS URL prefix that TikTok can fetch server-to-server (never localhost).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:3000/api/auth/callback/tiktok
TIKTOK_SCOPES=user.info.basic,video.upload,video.publish
TIKTOK_MEDIA_URL_PREFIX=https://media.example.com/

# Zark image pilot. Development/test only; production is always rejected in code.
ENABLE_ZARK_PROVIDER=false
ZARK_PILOT_MONTHLY_IMAGE_LIMIT=25
ZARK_API_BASE_URL=https://api.zarklab.ai

# AI generation traffic protection. Requests sharing one provider credential are serialized.
AI_PROVIDER_MIN_INTERVAL_MS=4000
AI_PROVIDER_DEFAULT_COOLDOWN_MS=60000

# Development only. Never enable in production.
ALLOW_DEMO_SESSION=true
